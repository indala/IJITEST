{
  "connector": {
    "name": "local",
    "options": {
      "pattern": [
        "**",
        "!**/*.html",
        "!**/*.htm",
        "!.git/**",
        "!node_modules/**",
        "!.next/**"
      ]
    }
  },
  "extends": [
    "development"
  ],
  "hints": {
    "axe/structure": [
      "default",
      {
        "list": "off"
      }
    ],
    "axe/label": [
      "on"
    ]
  }
}